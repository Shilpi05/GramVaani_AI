# ------------------------------------------
# Groq API Configuration
# ------------------------------------------

# Required
# Add your actual Groq API key in the local .env file.
# Never commit the real API key to GitHub.
GROQ_API_KEY=your_groq_api_key_here

# Primary LLM model
GROQ_MODEL=openai/gpt-oss-120b

# Fallback LLM model
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Optional - hard per-request timeout in seconds
# Default: 30
GROQ_TIMEOUT_SECONDS=30

# Optional - number of retry attempts on transient errors
# Default: 3
GROQ_RETRY_ATTEMPTS=3


# ------------------------------------------
# Speech Recognition
# ------------------------------------------

# Groq Whisper model used for speech-to-text
GROQ_WHISPER_MODEL=whisper-large-v3-turbo